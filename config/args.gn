# Aegis Browser - Configuración de Build Ultra Optimizada (100x Performance)
# Máxima reducción de consumo de CPU/RAM, arranque instantáneo y latencia mínima.

# ── 1. Optimización Binaria y Compilador ────────────────────────────────────
is_debug                = false
is_official_build       = true     # Habilita PGO, optimización de velocidad /O2 y LTO
is_component_build      = false    # Binario monolítico ultra rápido sin DLLs separadas
symbol_level            = 0        # Cero símbolos de debug (binario 70% más liviano)
blink_symbol_level      = 0
enable_stripping        = true
dcheck_always_on        = false

# ── 2. Optimizaciones Extremas de Memoria (RAM) y V8 ────────────────────────
use_thin_lto            = true     # Optimización de enlace global
optimize_webui          = true     # WebUI minificada en memoria
v8_enable_pointer_compression = true # Compresión de punteros V8: Reduce la memoria RAM JS en ~40%
use_partition_alloc_as_malloc = true # Asignador de memoria de baja fragmentación y alto rendimiento
v8_enable_fast_mksnapshot = true
v8_static_roots = true

# ── 3. Aceleración por Hardware y Rendimiento de CPU ───────────────────────
# Decodificación de video en GPU dedicada (pone la CPU a dormir al reproducir video)
media_use_ffmpeg        = true
media_use_libvpx        = true
rtc_use_h264            = true
proprietary_codecs      = true
ffmpeg_branding         = "Chrome"

# ── 4. Supresión Total de Telemetría, Bloat y Procesos Parásitos ───────────
enable_google_now                = false
enable_hangout_services_extension = false
enable_mdns                      = false   # Cero escaneo de red local en segundo plano
enable_reporting                 = false   # Cero telemetría a servidores remotos
enable_service_discovery         = false
enable_vr                        = false   # Sin servicios VR en RAM
safe_browsing_mode               = 0       # Cero pings de SafeBrowsing a Google
enable_paint_preview             = false   # Sin pre-renderizado innecesario en segundo plano
enable_service_manager_tracing   = false   # Sin hilos de rastreo de diagnóstico

google_api_key            = ""
google_default_client_id  = ""
google_default_client_secret = ""

# ── 5. Desactivación de Sync y Cuentas en la Nube ──────────────────────────
# Gestión de datos 100% local (DPAPI) sin procesos de sincronización remota
enable_signin_service = false

# ── 6. Extensiones y Motor Web ─────────────────────────────────────────────
enable_extensions       = true
enable_plugins          = true
enable_pdf              = true

# ── 7. Motor Nativo de Privacidad (Aegis Shields en Rust) ───────────────────
enable_aegis_shields    = true

# ── 8. Reducción de Tamaño y Tiempo de Arranque ────────────────────────────
exclude_unwind_tables   = true
use_debug_fission       = false
disable_fieldtrial_testing_config = true
