# Aegis Browser - Configuración de Build Android ARM64 Ultra Optimizada (100x Performance)
# Máxima fluidez a 120Hz, mínimo consumo de batería y cero servicios de Google.

# ── 1. Target y Arquitectura ────────────────────────────────────────────────
target_os               = "android"
target_cpu              = "arm64"
is_debug                = false
is_official_build       = true     # Optimización de release y LTO
is_component_build      = false
symbol_level            = 0
blink_symbol_level      = 0
enable_stripping        = true
dcheck_always_on        = false

# ── 2. Optimizaciones Extremas de RAM y Rendimiento V8 Móvil ───────────────
use_thin_lto            = true     # Link-Time Optimization en Android
optimize_webui          = true
v8_enable_pointer_compression = true # Ahorro de ~40% de RAM en dispositivos móviles
use_partition_alloc_as_malloc = true
v8_static_roots         = true     # Ejecución directa sin sobrecarga de indirección
disable_fieldtrial_testing_config = true
enable_paint_preview    = false    # Ahorro de memoria en segundo plano

# ── 3. Eliminación Total de GMS y Telemetría ────────────────────────────────
enable_google_now                = false
enable_hangout_services_extension = false
enable_mdns                      = false
enable_reporting                 = false
enable_service_discovery         = false
enable_vr                        = false
safe_browsing_mode               = 0

google_api_key            = ""
google_default_client_id  = ""
google_default_client_secret = ""
enable_signin_service     = false

# ── 4. Aceleración por Hardware y Batería (MediaCodec) ──────────────────────
# Decodificación de video en GPU móvil dedicada para que la CPU duerma
media_use_ffmpeg        = true
media_use_libvpx        = true
rtc_use_h264            = true
proprietary_codecs      = true

# ── 5. Motor de Bloqueo Nativo (Aegis Shields en Rust) ─────────────────────
enable_aegis_shields    = true
