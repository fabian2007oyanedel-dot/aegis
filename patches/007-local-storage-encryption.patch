index 41a1b2c..77d3e4f 100644
--- a/components/os_crypt/sync/os_crypt_win.cc
+++ b/components/os_crypt/sync/os_crypt_win.cc
@@ -25,6 +25,10 @@ namespace {
 // Aegis Browser: Cifrado local forzado mediante Windows DPAPI (Data Protection API)
 // Cero dependencia de claves derivadas de cuentas Google o sincronización en la nube.
 bool EncryptStringWithDPAPI(const std::string& plaintext, std::string* ciphertext) {
+  DATA_BLOB input;
+  input.pbData = const_cast<BYTE*>(reinterpret_cast<const BYTE*>(plaintext.data()));
+  input.cbData = static_cast<DWORD>(plaintext.length());
+  DATA_BLOB output;
   return ::CryptProtectData(&input, L"Aegis Master Key", nullptr, nullptr, nullptr,
                            CRYPTPROTECT_UI_FORBIDDEN, &output);
 }
