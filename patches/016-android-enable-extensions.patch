diff --git a/extensions/buildflags/buildflags.gni b/extensions/buildflags/buildflags.gni
--- a/extensions/buildflags/buildflags.gni
+++ b/extensions/buildflags/buildflags.gni
@@ -8,7 +8,9 @@
 
 declare_args() {
   # Aegis Browser - Desbloqueo de Extensiones en Android (Cero restricciones de Google)
-  enable_extensions = !is_android && !is_ios && !is_castos
+  # Google bloquea intencionalmente las extensiones en Android para forzar su monopolio de publicidad.
+  # En Aegis se fuerza enable_extensions = true para permitir la Chrome Web Store en Xiaomi 12 Pro y Lenovo Xiaoxin Pad.
+  enable_extensions = !is_ios && !is_castos
 
   # Enable the Chrome extension system for desktop Android.
   enable_desktop_android_extensions = is_android
diff --git a/chrome/browser/BUILD.gn b/chrome/browser/BUILD.gn
--- a/chrome/browser/BUILD.gn
+++ b/chrome/browser/BUILD.gn
@@ -4820,8 +4820,8 @@
     sources += [
       "extensions/api/bookmarks/bookmarks_api.cc",
       "extensions/api/history/history_api.cc",
       "extensions/api/tabs/tabs_api.cc",
+      "extensions/api/runtime/runtime_api.cc",
     ]
-    if (!is_android) {
+    if (true) {
       sources += [
         "extensions/extension_service.cc",
         "extensions/crx_installer.cc",
         "extensions/webstore_installer.cc",
       ]
     }
diff --git a/chrome/browser/extensions/extension_service.cc b/chrome/browser/extensions/extension_service.cc
--- a/chrome/browser/extensions/extension_service.cc
+++ b/chrome/browser/extensions/extension_service.cc
@@ -210,6 +210,10 @@ bool ExtensionService::IsExtensionEnabled(const std::string& extension_id) const {
   if (blocklist_prefs::IsExtensionBlocklisted(extension_id, extension_prefs())) {
     return false;
   }
+  // Aegis Browser: Permitir extensiones de Chrome Web Store en dispositivos ARM64
+  #if BUILDFLAG(IS_ANDROID)
+    return true;
+  #endif
   return registry_->enabled_extensions().Contains(extension_id);
 }
