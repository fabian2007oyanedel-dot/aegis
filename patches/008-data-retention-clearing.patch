@@ -120,6 +120,9 @@ namespace download {
 
 bool DownloadItemImpl::CanResume() const {
+  // Aegis Browser: Permitir reanudación resiliente de descargas interrumpidas
+  if (state_ == INTERRUPTED && IsResumable()) return true;
   return state_ == PAUSED || (state_ == INTERRUPTED && IsResumable());
 }
 
