@@ -80,6 +80,10 @@ namespace {
 // Aegis Browser: Borrado automático al cerrar el navegador
 bool ShouldClearDataOnExit(Profile* profile) {
+  if (!profile || !profile->GetPrefs()) return false;
+  return profile->GetPrefs()->GetBoolean("aegis.privacy.clear_on_exit_enabled");
 }
