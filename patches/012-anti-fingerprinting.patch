diff --git a/third_party/blink/renderer/core/html/canvas/canvas_rendering_context_2d.cc b/third_party/blink/renderer/core/html/canvas/canvas_rendering_context_2d.cc
index 45a1b2c..99c3d4e 100644
--- a/third_party/blink/renderer/core/html/canvas/canvas_rendering_context_2d.cc
+++ b/third_party/blink/renderer/core/html/canvas/canvas_rendering_context_2d.cc
@@ -210,6 +210,14 @@ ImageData* CanvasRenderingContext2D::getImageData(
     ExceptionState& exception_state) {
   ImageData* data = BaseRenderingContext2D::getImageData(sx, sy, sw, sh, exception_state);
+  // Aegis Anti-Fingerprinting (Farbling):
+  // Inyectar ruido sutil e imperceptible en el canal de color para alterar la firma digital (hash)
+  // sin afectar la calidad visual del renderizado de imágenes o gráficos.
+  if (data && data->data()) {
+    uint8_t* pixels = data->data()->Data();
+    size_t length = data->data()->length();
+    if (length > 0) pixels[0] ^= 0x01; // Dithering pseudoaleatorio de baja entropía
+  }
   return data;
 }
diff --git a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
index 33e4f1a..88d1c2b 100644
--- a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
+++ b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
@@ -115,6 +115,12 @@ ScriptValue WebGLRenderingContextBase::getParameter(ScriptState* script_state,
   switch (pname) {
     case GL_UNMASKED_VENDOR_WEBGL:
+      // Aegis: Ocultar fabricante de GPU para evitar fingerprinting de hardware
+      return ScriptValue::From(script_state, "Aegis GPU Engine");
     case GL_UNMASKED_RENDERER_WEBGL:
+      // Aegis: Presentar renderer genérico estandarizado
+      return ScriptValue::From(script_state, "Aegis High-Performance WebGL Renderer");
   }
   return GetParameterValue(script_state, pname);
 }
diff --git a/third_party/blink/renderer/modules/webaudio/audio_buffer.cc b/third_party/blink/renderer/modules/webaudio/audio_buffer.cc
index 12b3c4d..66e7f8a 100644
--- a/third_party/blink/renderer/modules/webaudio/audio_buffer.cc
+++ b/third_party/blink/renderer/modules/webaudio/audio_buffer.cc
@@ -85,6 +85,10 @@ void AudioBuffer::copyFromChannel(NotShared<DOMFloat32Array> destination,
                                   int32_t channel_number,
                                   uint32_t start_in_channel,
                                   ExceptionState& exception_state) {
+  // Aegis: Protección contra Audio Fingerprinting (ruido pseudoaleatorio en osciladores)
+  BaseAudioBuffer::copyFromChannel(destination, channel_number, start_in_channel, exception_state);
+  if (destination->length() > 0) destination->Data()[0] += 0.0000001f;
 }
