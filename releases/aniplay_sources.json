{
  "$schema": "https://raw.githubusercontent.com/fabian2007oyanedel-dot/aegis/main/config/aniplay_sources_schema.json",
  "repository": {
    "name": "Aegis AniPlay Community Source Repository",
    "id": "org.aegis.aniplay.repo.latin",
    "version": "1.0.0",
    "description": "Repositorio modular de fuentes para AniPlay en Aegis Browser con soporte para Anime, Películas y Series en Español y Latino con reglas anti-publicidad integradas.",
    "author": "Aegis Community",
    "updatedAt": "2026-10-26T20:45:00Z",
    "compatibleWith": "Aegis >= 1.3.0",
    "rawRepoUrl": "https://raw.githubusercontent.com/fabian2007oyanedel-dot/aegis/main/releases/aniplay_sources.json"
  },
  "extractors": [
    {
      "id": "streamwish",
      "name": "StreamWish",
      "domains": ["streamwish.to", "streamwish.com", "wishembed.pro", "embedwish.com", "strwish.xyz"],
      "type": "hls",
      "regex": "sources:\\s*\\[\\{file:\\s*[\"']([^\"']+\\.m3u8[^\"']*)[\"']",
      "requiresReferer": true
    },
    {
      "id": "filemoon",
      "name": "FileMoon",
      "domains": ["filemoon.sx", "filemoon.to", "filemoon.in"],
      "type": "hls",
      "regex": "file:\\s*[\"']([^\"']+\\.m3u8[^\"']*)[\"']",
      "requiresReferer": true
    },
    {
      "id": "voe",
      "name": "Voe",
      "domains": ["voe.sx", "voe-unblock.com", "repackers.link"],
      "type": "hls_or_mp4",
      "regex": "[\"']hls[\"']:\\s*[\"']([^\"']+)[\"']|[\"']file[\"']:\\s*[\"']([^\"']+\\.mp4)[\"']",
      "requiresReferer": false
    },
    {
      "id": "doodstream",
      "name": "DoodStream",
      "domains": ["dood.to", "dood.so", "doodstream.com", "ds2play.com"],
      "type": "mp4",
      "tokenRegex": "/pass_md5/([^\"']+)",
      "requiresReferer": true
    },
    {
      "id": "mp4upload",
      "name": "Mp4Upload",
      "domains": ["mp4upload.com"],
      "type": "mp4",
      "regex": "player\\.src\\([\"']([^\"']+\\.mp4)[\"']",
      "requiresReferer": true
    },
    {
      "id": "yourupload",
      "name": "YourUpload",
      "domains": ["yourupload.com"],
      "type": "mp4",
      "regex": "file:\\s*[\"']([^\"']+\\.mp4)[\"']",
      "requiresReferer": true
    },
    {
      "id": "tomatomatela",
      "name": "Tomatomatela (Cuevana)",
      "domains": ["tomatomatela.com", "pelispng.online"],
      "type": "hls",
      "regex": "var\\s+url\\s*=\\s*[\"']([^\"']+\\.m3u8)[\"']",
      "requiresReferer": true
    }
  ],
  "sources": [
    {
      "id": "animeflv",
      "name": "AnimeFLV",
      "category": "anime",
      "language": "es-ES",
      "audio": "Subtitulado",
      "baseUrl": "https://www3.animeflv.net",
      "mirrors": ["https://animeflv.net", "https://www.animeflv.net"],
      "version": "1.3.0",
      "icon": "https://www3.animeflv.net/favicon.ico",
      "status": "online",
      "description": "El portal de anime subtitulado en español más popular y completo.",
      "endpoints": {
        "popular": "/browse?order=rating",
        "latest": "/browse?order=added",
        "airing": "/browse?status=1&order=rating",
        "search": "/browse?q={query}",
        "genre": "/browse?genre={genre}"
      },
      "selectors": {
        "itemList": "ul.ListAnimes li article.Anime",
        "title": "h3.Title",
        "link": "a",
        "poster": "div.Image figure img",
        "type": "span.Type",
        "rating": "span.Vote span.vtprmd",
        "description": "div.Description p",
        "genres": "nav.Genres a",
        "episodeScriptRegex": "var\\s+episodes\\s*=\\s*(\\[\\[.*?\\]\\]);",
        "videoServersRegex": "var\\s+videos\\s*=\\s*(\\{.*?\\});"
      },
      "supportedExtractors": ["streamwish", "filemoon", "mega", "yourupload", "mp4upload"],
      "headers": {
        "Referer": "https://www3.animeflv.net/",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
      },
      "shieldRules": [
        "*://*.adkeeper.co/*",
        "*://*.adsterra.com/*",
        "*://*.propellerads.com/*",
        "*://*.clksite.com/*",
        "*://*.creativecdn.com/*",
        "*://*.effectivecpmcontent.com/*",
        "*://*.onclickbright.com/*"
      ]
    },
